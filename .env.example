# Kopieer naar .env (die staat in .gitignore) en vul het wachtwoord in.
# Wachtwoord om in te loggen (leesbaar; houd de rechten van dit bestand op 600).
APP_PASSWORD=''
# Naam in het inlogscherm en op het browsertabblad (optioneel).
APP_NAME='Kabelkrant Notities'
# Drempels voor "Afbeelding te groot": daarboven wordt gevraagd of de afbeelding verkleind moet worden.
# Langste zijde in pixels en bestandsgrootte in KB (2048 = 2 MB).
IMAGE_MAX_DIMENSION=2000
IMAGE_MAX_KB=2048
